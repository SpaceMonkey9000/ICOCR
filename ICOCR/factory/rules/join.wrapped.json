{
  "schema_version": 1,
  "id": "join.wrapped",
  "name": "Join wrapped part-number lines",
  "category": "Joining",
  "enabled": true,
  "kind": "wrapped_join",
  "priority": 100,
  "patterns": [
    {
      "first": "[A-Z]{2,8}[0-9]{1,6}",
      "second": "[0-9]{1,4}[A-Z]{1,4}",
      "exact_only": false
    },
    {
      "first": "[A-Z]{2,8}",
      "second": "[0-9]{3,6}",
      "exact_only": true
    }
  ]
}
